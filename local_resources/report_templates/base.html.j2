{% from "macros.html.j2" import render_section %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ meta.title | default("Report") }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>{{ inline_css }}</style>
  <style>
    /* Note expand/collapse */
    .note-item .note-item-body { display: none; }
    .note-item.expanded .note-item-body { display: block; }
    .note-item.expanded .note-item-header span:first-child { transform: rotate(90deg); display: inline-block; }
  </style>
</head>
<body>
  <div class="report-container">

    {# ---- Header ---- #}
    {% block header %}
    <header class="report-header">
      <h1>{% block title %}{{ meta.title | default("Report") }}{% endblock %}</h1>
      <div class="report-meta">
        {% block meta_items %}
        {% if meta.skill %}<span>{{ meta.skill }}</span>{% endif %}
        {% if generated_at %}<span>{{ generated_at }}</span>{% endif %}
        {% endblock %}
      </div>
    </header>
    {% endblock %}

    {# ---- Table of Contents ---- #}
    {% block toc %}
    <nav class="toc">
      <h2>Contents</h2>
      <ul>
        {% for section in sections %}
        <li><a href="#{{ section.id | default('section-' ~ loop.index0) }}">{{ section.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    {% endblock %}

    {# ---- Main Content ---- #}
    {% block content %}
    {% for section in sections %}
      {{ render_section(section, loop.index0) }}
    {% endfor %}
    {% endblock %}

    {# ---- Appendices ---- #}
    {% block appendices %}
    {% if appendices %}
    {% for appendix in appendices %}
    <div class="appendix">
      <h2>{{ appendix.title }}</h2>
      {% for item in appendix.items %}
      <div class="appendix-item">
        <h4>{{ item.title | default(item.topic | default("Note")) }}{% if item.tags %} <span style="color: var(--fg-faint); font-weight: normal;">{{ item.tags | join(", ") }}</span>{% endif %}</h4>
        <div class="note-content">{{ item.content_html | default(item.content | default("") | e) }}</div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
    {% endif %}
    {% endblock %}

    {# ---- Structured Data ---- #}
    {% block structured_data %}
    <div class="data-panel" id="structured-data">
      <h2>Structured Data</h2>
      <p class="data-intro">
        This report was generated from a structured knowledge graph built with
        <a href="https://sciknow.io/alhazen">Skillful Alhazen</a>.
        The underlying data is available as machine-readable JSON, preserving
        provenance, semantic structure, and the full investigation context.
      </p>

      <div class="data-meta-grid">
        <dt>Source</dt>
        <dd>{{ meta.skill | default("alhazen") }} / {{ meta.source_id | default("") }}</dd>
        <dt>Exported</dt>
        <dd>{{ generated_at }}</dd>
        <dt>Schema</dt>
        <dd>Report Data Schema v{{ meta.version | default(1) }}</dd>
        <dt>Sections</dt>
        <dd>{{ sections | length }} content sections{% if appendices %}, {{ appendices | length }} appendix{% if appendices | length > 1 %}es{% endif %}{% endif %}</dd>
      </div>

      <a class="data-download" href="data.json" download>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 1v10m0 0l-3-3m3 3l3-3M2 13h12"/></svg>
        Download data.json
      </a>

      <div class="data-schema">
        <details>
          <summary>View structured data</summary>
          <pre><code id="json-viewer"></code></pre>
        </details>
      </div>
    </div>
    {% endblock %}

    {# ---- Footer ---- #}
    {% block footer %}
    <footer class="report-footer">
      Generated by Skillful Alhazen Report Publisher | {{ generated_at }}
    </footer>
    {% endblock %}

  </div>

  <script>{{ inline_js }}</script>
  <script>
  // Embed report data for the JSON viewer
  var _reportData = {{ raw_json | default("null") }};
  </script>
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    mermaid.initialize({
      startOnLoad: true,
      theme: 'dark',
      themeVariables: {
        darkMode: true,
        background: '#070d1c',
        primaryColor: '#0c1628',
        primaryTextColor: '#c8dde8',
        primaryBorderColor: 'rgba(90,173,175,0.42)',
        lineColor: '#5aadaf',
        secondaryColor: '#0c1628',
        tertiaryColor: '#050a16',
        fontFamily: "'JetBrains Mono', monospace",
        fontSize: '12px'
      }
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.title | default("Alhazen Reports") }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Serif+Display&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>{{ inline_css }}</style>
  <style>
    .project-grid { display: grid; gap: 1.5rem; margin-top: 2rem; }
    .project-card {
      background: var(--bg-raised); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 1.5rem;
      text-decoration: none; color: inherit; transition: border-color 0.2s;
    }
    .project-card:hover { border-color: var(--teal); }
    .project-card h3 { font-family: var(--serif); color: var(--fg); margin-bottom: 0.5rem; font-size: 1.15rem; }
    .project-card p { color: var(--fg-dim); font-size: 0.9rem; margin-bottom: 0.75rem; }
    .project-card .report-count {
      font-family: var(--mono); font-size: 0.78rem; color: var(--fg-faint);
    }
    .project-card .access-badge {
      display: inline-block; font-family: var(--mono); font-size: 0.72rem;
      padding: 0.15rem 0.5rem; border-radius: 3px; margin-left: 0.5rem;
    }
    .access-encrypted { background: var(--teal-dim); color: var(--teal); }
    .access-public { background: rgba(184,200,74,0.18); color: var(--olive); }
    .site-intro { color: var(--fg-dim); font-size: 0.95rem; max-width: 40rem; line-height: 1.7; }
  </style>
</head>
<body>
  <div class="report-container">
    <header class="report-header">
      <h1>{{ site.title | default("Alhazen Reports") }}</h1>
      <div class="report-meta">
        <span>{{ site.owner | default("") }}</span>
        <span>{{ generated_at }}</span>
      </div>
    </header>

    <p class="site-intro">
      Investigation reports generated from structured knowledge graphs built with
      <a href="https://sciknow.io/alhazen">Skillful Alhazen</a>.
      Each report includes downloadable structured data artifacts.
    </p>

    <div class="project-grid">
      {% for project in projects %}
      <a class="project-card" href="{{ project.slug }}/">
        <h3>{{ project.title }}</h3>
        <p>{{ project.description | default("") }}</p>
        <span class="report-count">{{ project.reports | length }} report{{ "s" if project.reports | length != 1 }}</span>
        <span class="access-badge {{ 'access-encrypted' if project.access == 'encrypted' else 'access-public' }}">
          {{ project.access | default("encrypted") }}
        </span>
      </a>
      {% endfor %}
    </div>

    <footer class="report-footer">
      Generated by Skillful Alhazen Report Publisher | {{ generated_at }}
    </footer>
  </div>
</body>
</html>

# =============================================================================
# Alhazen Dashboard — Lightweight base image for plugin users
# =============================================================================
# Builds a dashboard with just the hub page and TypeDB status. Skill-specific
# pages are wired in later via `alhazen_core.py wire-dashboard`, then compiled by
# `alhazen_core.py rebuild-dashboard` (which runs `next build` inside the container).
#
# Build context: this directory (skills/alhazen-core/).
# The Dockerfile clones skillful-alhazen to get the dashboard source.
#
# IMPORTANT: node deps are installed in the FINAL stage, NOT copied across stages.
# A previous cross-stage `COPY --from=deps /app/ ./` dropped npm's node_modules/.bin
# symlinks (so the image had no `next` binary and `rebuild-dashboard` failed with
# "next: not found"). Installing here keeps .bin intact. `--include=dev` is required
# because `next build` needs typescript/tailwind/etc. (dev dependencies).
# =============================================================================

# Stage 1: Clone dashboard source from skillful-alhazen
FROM alpine/git AS dashboard-src
ARG REPO=https://github.com/sciknow-io/skillful-alhazen.git
ARG REF=main
RUN git clone --depth=1 --branch $REF $REPO /src

# Stage 2: Runtime — Node.js + Python + uv; install node deps here (NO build yet —
# the build happens via `rebuild-dashboard` after skills are wired in)
FROM python:3.11-slim AS runner

# Node.js + curl
RUN apt-get update && \
    apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# Install node deps in this final stage so node_modules/.bin (incl. `next`) is
# intact. --include=dev: `next build` (run later by rebuild-dashboard) needs the
# dev toolchain. ELECTRON_SKIP_BINARY_DOWNLOAD: electron is a dev dep used only for
# the desktop build — don't fetch its ~100MB binary here.
COPY --from=dashboard-src /src/dashboard/package*.json ./
RUN ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci --include=dev

# Dashboard source. node_modules is gitignored in the clone, so this does not
# clobber the install above.
COPY --from=dashboard-src /src/dashboard/ ./

# No skill dashboards baked in — all arrive via wire-dashboard + rebuild-dashboard
RUN echo '[]' > public/skills-config.json && echo '{}' > public/namespace-config.json

# Directory for skill wiring
RUN mkdir -p .claude/skills

# Environment
ENV PROJECT_ROOT=/app
ENV NEXT_TELEMETRY_DISABLED=1
ENV TYPEDB_HOST=typedb
ENV TYPEDB_PORT=1729
# No baked TYPEDB_DATABASE: dashboard libs set the per-skill DB themselves, or
# delegate to the gateway (which uses each skill's per-repo default).
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

EXPOSE 3000

# Placeholder until rebuild-dashboard produces .next/, after which the container
# restarts and serves the built app.
CMD ["sh", "-c", "if [ -d .next ]; then npm start; else echo 'Dashboard not yet built. Run: alhazen_core.py rebuild-dashboard' && sleep infinity; fi"]
